rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fallback block for general collections
    match /{document=**} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /messages/{messageId} {
      allow read, write: if true;
    }

    match /profiles/{profileId} {
      allow read, write: if true;
    }

    match /stories/{storyId} {
      allow read, write: if true;
    }
  }
}
